<pre class="code-snippet__js" data-lang="c"><code><span class="code-snippet_outer">library(ggsci)</span></code><code><span class="code-snippet_outer">library(ggplot2)</span></code><code><span class="code-snippet_outer">library(gridExtra)</span></code><code><span class="code-snippet_outer">data(diamonds) #ggplot2内置数据集，砖石相关信息</span></code><code><span class="code-snippet_outer">head(diamonds)</span></code></pre>
